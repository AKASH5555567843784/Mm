<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Glowing Pulse State Orb -->
        <FrameLayout
            android:id="@+id/expanded_pulse_container"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pulse_listening">

            <ImageView
                android:id="@+id/expanded_pulse_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Assistant Pulse"
                android:src="@drawable/ic_notification_listening" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/expanded_notif_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MM Voice Assistant"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expanded_pulse_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_notification_btn"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="PULSE ACTIVE"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/expanded_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🟢 Actively listening for 'MM'"
                android:textColor="#00E5FF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle / Processing status line -->
    <TextView
        android:id="@+id/expanded_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Say &quot;MM&quot; or tap Talk Now to launch live conversation &amp; run device actions."
        android:textColor="#C7BBE6"
        android:textSize="12sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_action_talk"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_btn"
            android:gravity="center"
            android:text="🎙️ Talk"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_action_privacy"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_notification_btn"
            android:gravity="center"
            android:text="🛡️ Privacy"
            android:textColor="#C7BBE6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_action_mute"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_btn"
            android:gravity="center"
            android:text="🔇 Mic"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_action_stop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_notification_btn"
            android:gravity="center"
            android:text="⏻ Off"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
